{
	"extends": "../../tsconfig.base.json",
	"compilerOptions": {
		"composite": true,
		"emitDeclarationOnly": true,
		"outDir": "dist/types",
		"module": "ESNext",
		"moduleResolution": "Bundler",
		"lib": ["ES2023", "DOM", "DOM.Iterable"],
		"jsx": "react-jsx",
		"types": ["vite/client"],
		"paths": { "@/*": ["./src/*"] }
	},
	"include": ["src"],
	"references": [{ "path": "../shared" }]
}
